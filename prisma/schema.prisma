generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  name      String?
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
}

model Router {
  id        String   @id @default(uuid())
  name      String
  host      String
  user      String
  password  String
  port      Int      @default(8728)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model FinanceLog {
  id           String   @id @default(uuid())
  batchComment String
  totalRevenue Float
  qty          Int
  createdAt    DateTime @default(now())
}

model Voucher {
  id        String   @id @default(uuid())
  code      String
  profile   String
  price     Float?
  routerId  String?
  createdAt DateTime @default(now())
}

model HotspotLead {
  id               String    @id @default(uuid())
  name             String
  phone            String?
  birthDate        DateTime?
  email            String?
  cpf              String?
  gender           String?
  password         String?   // The custom password chosen by the user
  customFieldValue String?
  hotspotUser      String    @unique // The generated username in MikroTik
  whatsappNumber   String?   // Used for Baileys messaging
  optInCourses     Boolean   @default(true) // Consent to receive course info
  drawnInRaffle    Boolean   @default(false) // Flag to prevent duplicate drawing
  createdAt        DateTime  @default(now())
  payments         Payment[]
}

model Payment {
  id               String      @id @default(uuid())
  leadId           String
  lead             HotspotLead @relation(fields: [leadId], references: [id])
  pixId            String?     @unique // Mercado Pago Payment ID
  pixPayload       String?     // PIX Copy Paste
  pixQrCodeBase64  String?     // QR Code Image
  status           String      @default("pending") // pending, approved, rejected
  amount           Float
  voucherCode      String?     // The generated voucher after payment
  profile          String?     // The selected profile/plan for WhatsApp flows
  macAddress       String?     // The MAC address used to drop IP Binding after payment
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model WhatsappPlan {
  id        String   @id @default(uuid())
  title     String   // e.g. "1 Hora", "1 Dia"
  profile   String   // MikroTik Profile exactly as typed
  price     Float
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model SystemConfig {
  key   String @id
  value String
}

model WhatsappInstance {
  id        String   @id @default(uuid())
  name      String   @default("WhatsApp")
  number        String?  // O número em si após conectar
  status        String   @default("disconnected")
  profilePicUrl String?
  createdAt     DateTime @default(now())
}
