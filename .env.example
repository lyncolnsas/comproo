DATABASE_URL="file:./dev.db"
JWT_SECRET="mikrogestor_super_secret_key_change_me_in_production"

# ─── WireGuard VPN ───────────────────────────────────────────────────────────
# Gerado na VPS com o script: sudo bash vpn/setup-vps.sh
VPS_WG_PUBLIC_KEY="COLE_AQUI_A_CHAVE_PUBLICA_DA_VPS"
# IP público da VPS onde o WireGuard está rodando
VPS_PUBLIC_IP="2.25.168.82"
# Subnet de controle VPN (padrão 10.8.0.1)
VPN_SERVER_IP="10.8.0.1"
WG_INTERFACE="wg0"

# ─── WireGuard Daemon (Host da VPS) ───────────────────────────────────────────
# No Docker/Coolify use o IP do host gateway (geralmente http://172.17.0.1:51821 ou http://host.docker.internal:51821)
WG_MANAGER_URL="http://172.17.0.1:51821"
# Token gerado pelo setup-vps.sh e salvo em /etc/wireguard/manager.secret
WG_MANAGER_SECRET="COLE_AQUI_O_SECRET_DO_DAEMON"
